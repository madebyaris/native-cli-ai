/// nca plugin API, version 1.
///
/// A plugin is a WASM component targeting the `plugin` world. Every export
/// must be present; hooks a plugin does not care about return `none` / `allow`,
/// which makes nca fall back to the next plugin in the chain and finally to the
/// built-in core behavior.
package nca:plugin@1.0.0;

interface types {
    /// Provider credentials. Unset fields keep the core / config value.
    record credential {
        api-key: option<string>,
        base-url: option<string>,
    }

    record spawn-request {
        task: string,
        focus-files: list<string>,
        skills: list<string>,
        use-worktree: bool,
    }

    variant spawn-decision {
        /// Spawn, using this (possibly rewritten) request.
        allow(spawn-request),
        /// Refuse to spawn; the string is shown to the parent agent.
        deny(string),
    }

    variant tool-decision {
        allow,
        deny(string),
    }

    /// Colour tokens as `(token, "#rrggbb")`.
    /// Tokens: bg surface border mention-bg user assistant tool muted text success error warn.
    type theme = list<tuple<string, string>>;

    enum log-level { debug, info, warn, error }
}

/// Services the host provides to plugins. Everything here is gated by the
/// capabilities declared in `nca-plugin.toml`.
interface host {
    use types.{credential, spawn-request, spawn-decision, theme, log-level};

    log: func(level: log-level, message: string);

    /// Value from the `[config]` table of the manifest.
    config-get: func(key: string) -> option<string>;

    /// Environment variable declared in `capabilities.env`.
    env-get: func(name: string) -> option<string>;

    record http-response {
        status: u16,
        body: list<u8>,
    }

    /// Blocking HTTP request. Host must be listed in `capabilities.network`.
    http-request: func(
        method: string,
        url: string,
        headers: list<tuple<string, string>>,
        body: option<list<u8>>,
    ) -> result<http-response, string>;

    /// Core / next-plugin behavior for `auth.resolve-credential`.
    next-credential: func(provider: string) -> result<option<credential>, string>;

    /// Core / next-plugin behavior for `subagent.before-spawn`.
    next-spawn-decision: func(request: spawn-request) -> result<spawn-decision, string>;

    /// Core / next-plugin behavior for `cosmetic.resolve-theme`.
    next-theme: func() -> result<theme, string>;
}

interface auth {
    use types.{credential};
    /// Called whenever a provider is built. `none` = no opinion (use next-credential).
    /// An `err` aborts provider construction (fail-closed).
    resolve-credential: func(provider: string) -> result<option<credential>, string>;
}

interface subagent {
    use types.{spawn-request, spawn-decision};
    before-spawn: func(request: spawn-request) -> result<spawn-decision, string>;
}

interface agent {
    use types.{tool-decision};
    /// Receives the assembled system prompt, returns a replacement (`none` = keep).
    transform-system-prompt: func(prompt: string) -> option<string>;
    /// Runs before every tool call, after the built-in approval flow.
    before-tool-use: func(tool: string, input-json: string) -> tool-decision;
}

interface cosmetic {
    use types.{theme};
    /// Returns the full or partial theme. Unlisted tokens keep their value.
    resolve-theme: func() -> result<theme, string>;
}

world plugin {
    import host;
    export auth;
    export subagent;
    export agent;
    export cosmetic;
}
